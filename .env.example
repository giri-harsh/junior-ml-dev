# Copy to .env. Never commit .env. All values below are placeholders.
DATABASE_URL=postgresql+psycopg://jmd:jmd@localhost:5432/jmd
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=jmdminio
MINIO_ROOT_PASSWORD=change-me-locally
MLFLOW_TRACKING_URI=http://localhost:5000
TRAJECTORY_DIR=data/trajectories

# LLM providers (all optional; MockLLM is used when unset) - wired in S7/S13
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
MAX_MONTHLY_USD=0

# Sandbox (optional; LocalDocker used when unset) - wired in S10
E2B_API_KEY=

# Admin auth - wired in S23
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
SCORER_SECRET=change-me-locally
SCORER_DATA=scorer_data

# Admin auth / approvals (no defaults: unset => login and approvals return 503)
JWT_SECRET=
APPROVAL_SECRET=
AUDIT_DB=data/audit.db
APPROVAL_DB=data/approvals.db
COOKIE_SECURE=0
